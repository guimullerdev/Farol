{
  "name": "@farol/desktop",
  "private": true,
  "version": "0.0.1",
  "description": "Assistente desktop de investimentos para iniciantes no mercado brasileiro",
  "author": "Farol",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
